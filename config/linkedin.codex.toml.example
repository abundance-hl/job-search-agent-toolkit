# Merge this table into your local Codex configuration; do not replace the file.
# The example is deliberately inactive until you configure it locally.
# Package version verified on 2026-10-27. Review upstream before changing the pin.
[mcp_servers.linkedin]
command = "uvx"
args = ["--python", "3.12", "mcp-server-linkedin==4.28.0", "--no-auto-import"]
startup_timeout_sec = 120
tool_timeout_sec = 300
enabled_tools = [
  "get_person_profile", "get_my_profile", "get_sidebar_profiles",
  "get_company_profile", "get_company_posts", "search_companies",
  "get_company_employees", "search_jobs", "get_saved_jobs", "search_people",
  "get_job_details", "get_feed", "search_posts", "close_session"
]

[mcp_servers.linkedin.env]
UV_HTTP_TIMEOUT = "300"
